# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""
APP_URL=""

# Neon PostgreSQL Connection String (Neon Console > Connection String)
DATABASE_URL=""

# Secret for JWT Authentication
JWT_SECRET="alguma_senha_muito_segura_aqui"

# Site Access Password (optional, defaults to shadow2034)
SITE_PASSWORD="shadow2034"
